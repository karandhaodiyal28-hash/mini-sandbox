<Application x:Class="ZeroTrustSandbox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared brushes / badge colors -->
            <SolidColorBrush x:Key="SafeBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFC107" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F44336" />
            <SolidColorBrush x:Key="UnknownBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#3F3F46" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
