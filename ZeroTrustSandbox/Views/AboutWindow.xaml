<Window x:Class="ZeroTrustSandbox.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="About Mini Sandbox" Height="430" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="#1B1B1B">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image x:Name="LogoImage" Width="56" Height="56" Margin="0,0,14,0"
                   VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mini Sandbox" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" Opacity="0.7" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.85"
                   Text="A free, lightweight tool that opens untrusted URLs and files inside an isolated preview environment — protecting you from phishing, malware and drive-by exploits without VMs or paid services." />

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Developer" FontWeight="Bold" Opacity="0.7" FontSize="12" />
            <TextBlock Text="Karan Dhaodiyal" FontSize="15" Margin="0,2,0,12" />

            <TextBlock Text="Connect &amp; get updates" FontWeight="Bold" Opacity="0.7" FontSize="12" />
            <TextBlock Margin="0,2,0,0" FontSize="14">
                <Hyperlink NavigateUri="https://github.com/karandhaodiyal28-hash"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    github.com/karandhaodiyal28-hash
                </Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,14,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="© 2026 Karan Dhaodiyal · Released under the MIT License." />
        </StackPanel>

        <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right" MinWidth="90"
                Margin="0,16,0,0" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
