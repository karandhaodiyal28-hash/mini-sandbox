<Window x:Class="ZeroTrustSandbox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Settings" Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="#1B1B1B">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- General -->
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox Content="Start in dark mode" IsChecked="{Binding Settings.StartInDarkMode}" Margin="0,6" />
                    <CheckBox Content="High contrast mode" IsChecked="{Binding Settings.HighContrast}" Margin="0,6" />
                    <CheckBox Content="Randomize browser fingerprint per session" IsChecked="{Binding Settings.RandomizeFingerprint}" Margin="0,6" />
                    <CheckBox Content="Block third-party cookies" IsChecked="{Binding Settings.BlockThirdPartyCookies}" Margin="0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="Session timeout (min):" VerticalAlignment="Center" Width="180" />
                        <ui:NumberBox Value="{Binding Settings.SessionTimeoutMinutes}" Minimum="1" Maximum="240" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="Max session memory (MB):" VerticalAlignment="Center" Width="180" />
                        <ui:NumberBox Value="{Binding Settings.MaxSessionMemoryMb}" Minimum="16" Maximum="512" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Security -->
            <TabItem Header="Security">
                <StackPanel Margin="12">
                    <CheckBox Content="VirusTotal scanning" IsChecked="{Binding Settings.EnableVirusTotal}" Margin="0,6" />
                    <CheckBox Content="OpenPhish feed" IsChecked="{Binding Settings.EnableOpenPhish}" Margin="0,6" />
                    <CheckBox Content="Certificate Transparency (crt.sh)" IsChecked="{Binding Settings.EnableCertTransparency}" Margin="0,6" />
                    <CheckBox Content="Have I Been Pwned password checks" IsChecked="{Binding Settings.EnableHibp}" Margin="0,6" />
                    <CheckBox Content="YARA-lite scanning" IsChecked="{Binding Settings.EnableYaraLite}" Margin="0,6" />
                    <CheckBox Content="Local heuristic analysis" IsChecked="{Binding Settings.EnableHeuristics}" Margin="0,6" />
                    <Separator Margin="0,10" />
                    <CheckBox Content="DNS-over-HTTPS (Cloudflare → Quad9)" IsChecked="{Binding Settings.EnableDnsOverHttps}" Margin="0,6" />
                    <CheckBox Content="Network isolation (block off-origin requests)" IsChecked="{Binding Settings.NetworkIsolationMode}" Margin="0,6" />
                </StackPanel>
            </TabItem>

            <!-- API Keys -->
            <TabItem Header="API Keys">
                <StackPanel Margin="12">
                    <TextBlock Text="VirusTotal API Key" FontWeight="SemiBold" />
                    <TextBlock Text="Free tier: 4 requests/min, 500/day. Stored DPAPI-encrypted; never leaves this PC unencrypted."
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,8" />
                    <PasswordBox x:Name="ApiKeyBox" ui:ControlHelper.PlaceholderText="64-character hexadecimal key" />
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Button Content="Test &amp; Save" Style="{StaticResource AccentButtonStyle}" Click="SaveKey_Click" />
                        <Button Content="Remove Key" Margin="8,0,0,0" Command="{Binding RemoveKeyCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding KeyStatus}" TextWrapping="Wrap" Margin="0,6" />
                    <TextBlock Text="{Binding QuotaText}" Opacity="0.8" Margin="0,10,0,0" />
                    <ui:ProgressRing IsActive="{Binding IsWorking}" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,6" />
                </StackPanel>
            </TabItem>

            <!-- Threat Feeds -->
            <TabItem Header="Threat Feeds">
                <StackPanel Margin="12">
                    <TextBlock Text="DNS-over-HTTPS resolvers" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.DohPrimary}" Margin="0,4" ui:ControlHelper.Header="Primary" />
                    <TextBox Text="{Binding Settings.DohFallback}" Margin="0,4" ui:ControlHelper.Header="Fallback" />
                    <TextBlock Text="Blocklists such as StevenBlack/hosts and Firebog can be imported from the main window's blocklist manager."
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" MinWidth="90" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SaveSettingsCommand}" Click="Save_Click" />
            <Button Content="Close" MinWidth="90" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
