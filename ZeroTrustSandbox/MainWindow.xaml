<Window x:Class="ZeroTrustSandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:ZeroTrustSandbox.Converters"
        Title="Mini Sandbox — by Karan Dhaodiyal" Height="800" Width="1280"
        Icon="Resources/appicon.png"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="#1B1B1B">
    <Window.Resources>
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:ThreatLevelToBrushConverter x:Key="LevelToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center"
                        Margin="4,0,10,0"
                        Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

                <Button Grid.Column="1" Content="◀" MinWidth="36" ToolTip="Back"
                        Command="{Binding BackCommand}" />
                <Button Grid.Column="2" Content="▶" MinWidth="36" Margin="4,0,0,0" ToolTip="Forward"
                        Command="{Binding ForwardCommand}" />
                <Button Grid.Column="3" Content="↻" MinWidth="36" Margin="4,0,10,0" ToolTip="Reload"
                        Command="{Binding ReloadCommand}" />

                <TextBox Grid.Column="4" x:Name="AddressBar"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         ui:ControlHelper.PlaceholderText="Enter a URL to preview safely (https://…)"
                         FontSize="14" VerticalContentAlignment="Center" Padding="8,6"
                         KeyDown="AddressBar_KeyDown" />

                <Button Grid.Column="5" Content="Preview" Margin="8,0,0,0" MinWidth="90"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding PreviewUrlCommand}" />

                <Button Grid.Column="6" Content="Open File…" Margin="8,0,0,0"
                        Click="OpenFile_Click" />

                <Button Grid.Column="7" Content="⚙" Margin="8,0,0,0" MinWidth="40" ToolTip="Settings"
                        Click="Settings_Click" />

                <Button Grid.Column="8" Content="ℹ About" Margin="8,0,0,0" MinWidth="70" ToolTip="About / Connect"
                        Click="About_Click" />

                <Button Grid.Column="9" Content="⛔ Destroy Session" Margin="8,0,0,0"
                        Foreground="White" Background="{StaticResource DangerBrush}"
                        IsEnabled="{Binding SessionActive}"
                        Click="ForceDestroy_Click" />
            </Grid>
        </Border>

        <!-- ===== Main preview + dashboard ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Preview canvas -->
            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="Preview" />
                    <!-- Security watermark -->
                    <TextBlock Text="🛡 ZERO TRUST SANDBOX — ISOLATED PREVIEW"
                               IsHitTestVisible="False" Opacity="0.10" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               Margin="12" Foreground="#B0B0B0" MaxWidth="600" />
                    <ui:ProgressRing IsActive="{Binding IsBusy}" Width="48" Height="48" />
                </Grid>
            </Border>

            <!-- Threat dashboard -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="6"
                    Margin="8,0,0,0" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="THREAT DASHBOARD" FontWeight="Bold" FontSize="13" Opacity="0.7" />
                        <Border Margin="0,10" Padding="12" CornerRadius="6"
                                Background="{Binding Level, Converter={StaticResource LevelToBrush}}">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                <TextBlock Foreground="White" Opacity="0.9">
                                    <Run Text="Risk score: " />
                                    <Run Text="{Binding RiskScore, Mode=OneWay}" />
                                    <Run Text="/100" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SessionTimerText}" Opacity="0.7" Margin="0,0,0,8" />
                        <TextBlock Text="Findings" FontWeight="SemiBold" Margin="0,4" />
                    </StackPanel>

                    <ListView ItemsSource="{Binding Findings}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,2" CornerRadius="4" Background="#2D2D30">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" Margin="16,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Network log ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="NETWORK LOG" FontWeight="Bold" FontSize="12" Opacity="0.7" HorizontalAlignment="Left" />
                    <TextBlock Text="Developer: Karan Dhaodiyal" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                </Grid>
                <DataGrid ItemsSource="{Binding Network}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent"
                          RowBackground="Transparent" BorderThickness="0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat=HH:mm:ss}" Width="70" />
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="60" />
                        <DataGridTextColumn Header="URI" Binding="{Binding Uri}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="60" />
                        <DataGridCheckBoxColumn Header="Blocked" Binding="{Binding Blocked}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
